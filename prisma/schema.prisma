generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  INTERVIEWER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum NotificationType {
  NEW_CANDIDATE
  INTERVIEW_REMINDER
  STATUS_CHANGED
  OFFER_SENT
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  website     String?
  industry    String?
  description String?
  users       User[]
  jobs        Job[]
  candidates  Candidate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  roles Role[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  roleId       String
  companyId    String?
  role         Role      @relation(fields: [roleId], references: [id])
  company      Company?  @relation(fields: [companyId], references: [id])
  interviews   Interview[] @relation("InterviewerAssignments")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Job {
  id           String        @id @default(cuid())
  companyId    String
  title        String
  department   String
  location     String
  salary       String?
  requirement  String        @db.Text
  benefit      String?       @db.Text
  deadline     DateTime?
  status       JobStatus     @default(DRAFT)
  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Candidate {
  id           String        @id @default(cuid())
  companyId    String?
  fullName     String
  email        String        @unique
  phone        String?
  avatarUrl    String?
  experience   String?
  education    String?
  source       String?
  notes        String?       @db.Text
  company      Company?      @relation(fields: [companyId], references: [id])
  applications Application[]
  evaluations  Evaluation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Application {
  id          String            @id @default(cuid())
  candidateId String
  jobId       String
  status      ApplicationStatus @default(APPLIED)
  score       Int               @default(0)
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  job         Job               @relation(fields: [jobId], references: [id])
  interviews  Interview[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Interview {
  id             String         @id @default(cuid())
  applicationId  String
  interviewerId  String
  scheduledAt    DateTime
  meetingLink    String?
  notes          String?        @db.Text
  status         InterviewStatus @default(SCHEDULED)
  application    Application    @relation(fields: [applicationId], references: [id])
  interviewer    User           @relation("InterviewerAssignments", fields: [interviewerId], references: [id])
  evaluations    Evaluation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Evaluation {
  id           String   @id @default(cuid())
  candidateId  String
  interviewId  String?
  technical    Int
  communication Int
  attitude     Int
  experience   Int
  totalScore   Int
  notes        String?  @db.Text
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  interview    Interview? @relation(fields: [interviewId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}
